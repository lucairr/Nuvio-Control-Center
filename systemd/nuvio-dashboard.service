[Unit]
Description=Nuvio Control Center web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nuvio-updater
Group=nuvio-updater
WorkingDirectory=/opt/nuvio-updater
Environment=HOME=/var/lib/nuvio-updater
Environment=NUVIO_HOME=/var/lib/nuvio-updater
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -m nuvio.server serve
Restart=on-failure
RestartSec=4
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nuvio-updater
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
